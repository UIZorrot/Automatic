CHANNEL_AUTH_SECRET=replace-with-strong-random-secret
# 仅当房间设了密码时填写；留空表示开放房间
BRIDGE_ROOM_PASSWORD=

# Automatic -> agent bridge
AUTOMATIC_BASE_URL=http://127.0.0.1:3000
AUTOMATIC_CHANNEL_IDS=jlhemcmnpjneeecokbgkhhckkpdbmima
BRIDGE_AGENT_KIND=hermes
BRIDGE_POLL_INTERVAL_MS=1500
BRIDGE_HISTORY_LIMIT=12
BRIDGE_AGENT_TIMEOUT_MS=120000
BRIDGE_REPLY_LIMIT=1900
# Hermes CLI（默认）
HERMES_CLI_BIN=hermes
HERMES_CLI_ARGS=chat,-Q,--source,automatic-bridge,-q,{prompt}
# Codex CLI（把 BRIDGE_AGENT_KIND 改成 codex 时启用）
CODEX_CLI_BIN=codex
CODEX_CLI_ARGS=exec,--skip-git-repo-check,--full-auto,{prompt}
# 自定义提示词模板
HERMES_PROMPT_TEMPLATE=You are the agent connected to Automatic. Reply as the agent in a lightweight channel.\n\nRecent conversation:\n{history}\n\nLatest user message:\n{message}\n\nReply concisely and naturally as the agent.

# 二选一：
# 1) 直接提供完整 DATABASE_URL
DATABASE_URL=

# 2) 或使用分字段配置（与 Supabase Pooler 兼容）
DATABASE_HOST=
DATABASE_USER=
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_PASSWORD=
DATABASE_SSL=true
